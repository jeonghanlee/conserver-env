.DEFAULT_GOAL := help

.PHONY: help default init distclean deinit

help:
	$(info --------------------------------------- )
	$(info Make Targets)
	$(info --------------------------------------- )
	$(QUIET) awk '/^[a-zA-Z\-_0-9]+:/ {            \
	  nb = sub( /^## /, "", helpMsg );              \
	  if(nb == 0) {                                 \
	    helpMsg = $$0;                              \
	    nb = sub( /^[^:]*:.* ## /, "", helpMsg );   \
	  }                                             \
	  if (nb)                                       \
	    print  $$1 "\t" helpMsg;                    \
	}                                               \
	{ helpMsg = $$0 }'                              \
	$(MAKEFILE_LIST) | column -ts:

default: help

## Fetch Source
init:
	@if [ -d "$(SRC_PATH)" ]; then \
	    printf "Directory '%s' already exists.\n" "$(SRC_PATH)"; \
	    printf "Remove and re-fetch? [y/N]: "; \
	    read confirm; \
	    if [ "$$confirm" = "y" ] || [ "$$confirm" = "Y" ]; then \
	        rm -rf "$(SRC_PATH)"; \
	    else \
	        printf "Aborted.\n"; \
	        exit 0; \
	    fi; \
	fi
	$(QUIET) rm -rf "$(SRC_DIST_DIR)" "$(SRC_DIST_FILE)"
	$(QUIET) wget -O "$(SRC_DIST_FILE)" "$(SRC_DIST_URL)"
	$(QUIET) tar --warning=no-unknown-keyword --exclude='._*' -xzf "$(SRC_DIST_FILE)"
	$(QUIET) mv "$(SRC_DIST_DIR)" "$(SRC_PATH)"
	$(QUIET) rm -f "$(SRC_DIST_FILE)"

## Clean Source
distclean:
	$(call distclean, $(SRC_PATH))

deinit: distclean

.PHONY: build conf all

build:
	$(QUIET) $(MAKE) -C $(SRC_PATH)

all: conf build install

FORCE:
